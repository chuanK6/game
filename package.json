{
  "name": "youlun-game-resource",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --config worker/wrangler.toml",
    "build": "vue-tsc -b && tsc -p worker/tsconfig.json --noEmit && vite build",
    "typecheck": "vue-tsc -b",
    "typecheck:api": "tsc -p worker/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "element-plus": "^2.11.3",
    "hono": "^4.9.6",
    "lucide-vue-next": "^0.542.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6",
    "wrangler": "^4.33.2"
  }
}
